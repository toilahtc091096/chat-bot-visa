# Sao chép file này thành .env rồi điền giá trị. KHÔNG commit file .env.

# Khóa API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Tài khoản đăng nhập web, dạng ten:matkhau, cách nhau bằng dấu phẩy
APP_USERS=admin:doi-mat-khau-nay

# Postgres. Có thể dùng chung database với dự án lọc hồ sơ: bảng của Sổ lỗi nằm riêng trong schema DB_SCHEMA.
DATABASE_URL=postgresql://so_loi:matkhau@127.0.0.1:5432/ten_database
DB_SCHEMA=so_loi

# Web: 127.0.0.1 = chỉ mở trong VPS. Cho người ngoài vào qua HTTPS: dùng Caddy, xem DEPLOY.md mục "Cho cả nhóm truy cập từ bên ngoài"
HOST=127.0.0.1
PORT=3000
TZ=Asia/Ho_Chi_Minh
DATA_DIR=./data

# Dự án lọc hồ sơ (đang đăng nhập Zalo) gửi tin sang với header X-Ingest-Token.
# Tạo bằng: openssl rand -hex 32
INGEST_TOKEN=
# Id nhóm Zalo "Xử lý hồ sơ lỗi". Để trống: lấy nhóm của tin đầu tiên nhận được.
ZALO_GROUP_ID=

# Model AI
LLM_MODEL_EXTRACT=claude-sonnet-5-5
LLM_MODEL_CHAT=claude-haiku-5-5
LLM_MODEL_IMAGE_CHEAP=claude-haiku-5-5
LLM_MODEL_IMAGE_FULL=claude-sonnet-5-5
# Che số giấy tờ, SĐT, email trước khi gửi chữ lên AI
MASK_PII=true

# Tự động xử lý tin mới mỗi N phút, chỉ xử lý tin đã "yên" ít nhất M phút
PROCESS_INTERVAL_MIN=30
PROCESS_QUIET_MIN=15
EXTRACT_CHUNK_SIZE=120

# Ảnh: khoảng cách hash tối đa để coi là ảnh gần giống (0-64, nhỏ = khắt khe)
IMAGE_HASH_MAX_DISTANCE=6
# Độ tin cậy tối thiểu để chấp nhận kết quả của model rẻ
IMAGE_CHEAP_MIN_CONFIDENCE=0.75
